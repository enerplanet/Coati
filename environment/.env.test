# Test environment: what CI runs, in a container.
#
#   make -C environment check ENV=test   # tests with coverage, then lint and types
#
# Same variables as .env.dev; see there for what each one does.

COMPOSE_PROJECT_NAME=coati-env
IMAGE_TAG=coati-env:test

# The oldest version of Python that Coati supports.
PYTHON_VERSION=3.10

# The suite with coverage, which fails below the threshold of pyproject.toml.
TEST_TARGET=cover

# Do not use the cache of earlier runs, so that every run stands for itself.
PYTEST_ADDOPTS=-p no:cacheprovider

DOCS_PORT=8000
