# Development environment.
#
# Read by docker compose (environment/docker-compose.yml) through the Make
# targets in this folder:
#   make -C environment test ENV=dev
#
# Everything here is a build/test setting; Coati has no runtime configuration
# or credentials.

# Compose project name (portable replacement for the v2-only `name:` key).
COMPOSE_PROJECT_NAME=coati-env

# Image tag for this environment. (compose only)
IMAGE_TAG=coati-env:dev

# Version of Python of the image; any that Coati supports, 3.10 or newer.
PYTHON_VERSION=3.12

# Root Makefile target the `test` service runs: the plain suite.
TEST_TARGET=test

# Options applied to every run of pytest inside the container. Empty: the
# defaults of pyproject.toml.
PYTEST_ADDOPTS=

# Host port the docs service publishes; the container listens on 8000.
DOCS_PORT=8000
